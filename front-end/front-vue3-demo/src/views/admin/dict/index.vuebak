<template>
  <div>
    <PageHeader title="数据字典" description="管理系统中的字典数据，包括空间类型、区域、楼层、设备类型、违规类型、消息类型等" />

    <div class="flex gap-4">
      <!-- Left panel: dict types -->
      <div class="w-64 shrink-0">
        <el-card shadow="never">
          <template #header>
            <span class="font-semibold text-slate-900 dark:text-slate-100">字典类型</span>
          </template>
          <div class="flex flex-col gap-1">
            <button
              v-for="item in dictTypes"
              :key="item.type"
              :class="[
                'w-full rounded-lg px-3 py-2.5 text-left text-sm transition-colors',
                activeType === item.type
                  ? 'bg-primary/10 font-medium text-primary dark:bg-primary/20'
                  : 'text-slate-600 hover:bg-slate-100 dark:text-slate-400 dark:hover:bg-slate-800',
              ]"
              @click="selectType(item.type)"
            >
              {{ item.label }}
              <span class="ml-2 text-xs text-slate-400">({{ typeCount(item.type) }})</span>
            </button>
          </div>
        </el-card>
      </div>

      <!-- Right panel: dict items -->
      <div class="flex-1 min-w-0">
        <div class="mb-4 flex items-center justify-between">
          <h3 class="text-lg font-semibold text-slate-900 dark:text-slate-100">
            {{ activeTypeLabel }} - 字典项
          </h3>
          <el-button type="primary" @click="openAdd">
            <el-icon><Plus /></el-icon>
            新增字典项
          </el-button>
        </div>

        <el-table v-if="activeType" :data="list" v-loading="loading" stripe border class="w-full">
          <el-table-column
            v-for="col in tableColumns"
            :key="col.prop"
            :prop="col.prop"
            :label="col.label"
            :width="col.width"
            :min-width="col.minWidth"
            show-overflow-tooltip
          >
            <template v-if="col.prop === 'status'" #default="{ row }">
              <el-switch
                :model-value="row.status === 1"
                @change="(val: boolean) => handleToggleStatus(row, val)"
              />
            </template>
            <template v-else-if="col.prop === 'remark'" #default="{ row }">
              {{ row.remark || row.remark || '-' }}
            </template>
          </el-table-column>
          <el-table-column label="操作" width="160" fixed="right">
            <template #default="{ row }">
              <el-button type="primary" link size="small" @click="openEdit(row)">编辑</el-button>
              <el-popconfirm title="确定删除该项？" confirm-button-text="删除" @confirm="handleDelete(row.id)">
                <template #reference>
                  <el-button type="danger" link size="small">删除</el-button>
                </template>
              </el-popconfirm>
            </template>
          </el-table-column>
        </el-table>

        <div v-else class="flex items-center justify-center py-32 text-slate-400 dark:text-slate-500">
          请选择左侧字典类型
        </div>
      </div>
    </div>

    <!-- Modal -->
    <DictModal
      v-model:visible="modalVisible"
      :mode="modalMode"
      :dict-type="activeType"
      :form-data="editingItem"
      @saved="fetchList"
    />
  </div>
</template>

<script setup lang="ts">
import { dictTypes, tableColumns } from './data'
import DictModal from './modal.vue'
import { meMsgSuccess, meMsgError } from '@/utils/modal'
import type {DictVO} from "@/api/admin/system/dict/type.ts";
import {deleteDict, getAllDicts, saveDict} from "@/api/admin/system/dict/api.ts";

const loading = ref(false)
const allDicts = ref<{ dictType: string; items: DictVO[] }[]>([])
const list = ref<DictVO[]>([])
const activeType = ref('')
const modalVisible = ref(false)
const modalMode = ref<'add' | 'edit'>('add')
const editingItem = ref<Partial<DictVO>>({})

const activeTypeLabel = computed(() => {
  return dictTypes.find((d) => d.type === activeType.value)?.label || ''
})

function typeCount(type: string): number {
  const group = allDicts.value.find((g) => g.dictType === type)
  return group?.items?.length || 0
}

function selectType(type: string) {
  activeType.value = type
  fetchList()
}

async function fetchAllDicts() {
  try {
    const res = await getAllDicts()
    if (res.code === "0") allDicts.value = res.data
  } catch { /* handled */ }
}

async function fetchList() {
  if (!activeType.value) return
  loading.value = true
  try {
    const group = allDicts.value.find((g) => g.dictType === activeType.value)
    list.value = (group?.items || []).sort((a, b) => a.sortOrder - b.sortOrder)
  } finally {
    loading.value = false
  }
}

function openAdd() {
  modalMode.value = 'add'
  editingItem.value = { dictLabel: '', dictValue: '', remark: '', sortOrder: 99, status: 1 }
  modalVisible.value = true
}

function openEdit(row: DictVO) {
  modalMode.value = 'edit'
  editingItem.value = { ...row }
  modalVisible.value = true
}

async function handleToggleStatus(row: DictVO, val: boolean) {
  try {
    const res = await saveDict({ ...row, status: val ? 1 : 0 } as any)
    if (res.code === "0") {
      meMsgSuccess({ message: '状态更新成功' })
      fetchAllDicts().then(() => fetchList())
    }
  } catch { /* handled */ }
}

async function handleDelete(id: number) {
  try {
    const res = await deleteDict(id)
    if (res.code === "0") {
      meMsgSuccess({ message: '删除成功' })
      fetchAllDicts().then(() => fetchList())
    }
  } catch { /* handled */ }
}

onMounted(async () => {
  await fetchAllDicts()
  activeType.value = dictTypes[0]?.type || ''
  fetchList()
})
</script>
