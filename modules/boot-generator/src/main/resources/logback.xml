<?xml version="1.0" encoding="UTF-8"?>
<!--
  日志级别: TRACE < DEBUG < INFO < WARN < ERROR < FATAL
-->
<configuration debug="false" scan="true" scanPeriod="10 seconds">

    <!-- 静默 logback 自身的内部状态日志（如 ReconfigureOnChangeTask、ConsoleAppender 提示等） -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>

    <property name="PATH" value="logs"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%red(%d{yyyy-MM-dd HH:mm:ss.SSS}) %green([%-10thread]) %blue([%-5level]) %cyan(%logger{60}:%line) - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 静默第三方噪音日志 -->
    <logger name="org.hibernate.validator" level="error" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.opengauss.core" level="error" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.baomidou" level="warn"/>

    <root level="info">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
