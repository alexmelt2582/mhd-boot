<?xml version="1.0" encoding="UTF-8"?>
<!-- 日志级别: 从低到高分为TRACE < DEBUG < INFO < WARN < ERROR < FATAL，如果设置为WARN，则低于WARN的信息都不会输出 -->
<!-- debug:当此属性设置为true时，将打印出logback内部日志信息，实时查看logback运行状态。默认值为false -->
<!-- scan: 当此属性设置为true时，配置文件如果发生改变，将会被重新加载，默认值为true -->
<!-- scanPeriod: 设置监测配置文件是否有修改的时间间隔，如果没有给出时间单位，默认单位是毫秒。当scan为true时，此属性生效。默认的时间间隔为1分钟 -->
<configuration debug="false" scan="true" scanPeriod="10 seconds">

    <!-- 设置上下文名称，默认是default，用于区分不同应用程序的记录。一旦设置，不能修改,可以通过%contextName来打印日志上下文名称 -->
    <!--<contextName>logback</contextName>-->

    <!-- name的值是变量的名称，value的值时变量定义的值。通过定义的值会被插入到logger上下文中。定义变量后，可以使“${}”来使用变量。 -->
    <!-- value: 生成日志的路径：绝对路径或者相对路径 -->
    <property name="PATH" value="logs"/>

    <!-- 彩色日志 -->
    <!-- 彩色日志格式设置 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%red(%d{yyyy-MM-dd HH:mm:ss.SSS}) %green([%-10thread]) %blue([%-5level]) %cyan(%logger{60}:%line) - %msg%n"/>

    <!--输出到控制台: 彩色-->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <Pattern>${CONSOLE_LOG_PATTERN}</Pattern>
            <!-- 设置字符集 -->
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--输出到控制台: 黑白-->
    <!--<appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">-->
    <!--    <encoder>-->
    <!--        <Pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%-15thread] %-5level %logger{50} - %msg%n</Pattern>-->
    <!--    </encoder>-->
    <!--</appender>-->

    <logger name="org.hibernate.validator" level="error" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="org.opengauss.core" level="error" additivity="false">
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 当日志级别是debug时，输出方式 -->
    <root level="debug">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- 当日志级别是info时，输出方式 -->
    <root level="info">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>